.game-network-required-form__root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

#networkRequiredCard #body {
    position: absolute;
    left: 84px;
    top: 565px;
    width: 765px;
    height: 114.92px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: upper-center;
    font-size: 39px;
    color: rgba(0, 0, 0, 1.000);
    white-space: normal;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
}
#networkRequiredCard #title {
    position: absolute;
    left: 28.5px;
    top: 424px;
    width: 876px;
    height: 93px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}
#networkRequiredCard #icon {
    position: absolute;
    left: 338.5px;
    top: 96px;
    width: 256px;
    height: 256px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    background-image: url("../Textures/NetworkRequiredForm/network-required-card-icon.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
}
#networkRequiredCard #primary {
    position: absolute;
    left: 84px;
    top: 741px;
    width: 765px;
    height: 156px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}
#networkRequiredCard #secondary {
    display: none;
}
.game-network-required-form__ingameneednetworkview {
    position: absolute;
    left: 0;
    margin-left: 0;
    top: 0;
    margin-top: 0;
    right: 0;
    margin-right: 0;
    bottom: 0;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0.800);
}
