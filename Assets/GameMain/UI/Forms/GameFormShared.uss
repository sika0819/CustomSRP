/* Design column: Boluo content is authored for 1125×2436.
   Pad Expand can make the panel taller/wider than the design canvas — keep a fixed
   1125×2436 stage centered in the panel so bottom-anchored sheets (USS baseline
   120px above stage bottom, matching Boluo; override via GameFormLogic.SheetBottomOffset)
   and top:px rows stay aligned on every aspect. */
.game-form-stage {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1125px;
    height: 2436px;
    margin-left: -562.5px;
    margin-top: -1218px;
    margin-right: 0;
    margin-bottom: 0;
    overflow: visible;
    picking-mode: Ignore;
}

/* Download NoticeCard — Boluo MobileDataInUsePage on the 1125×2436 stage:
   bottom-center anchor, pivot 0.5, anchoredY 661.5, size 933×1083
   → card bottom = 661.5 − 1083/2 = 120 above stage bottom.
   Progress card (957h, anchoredY 598.5) yields the same 120 inset.
   Must live inside .game-form-stage (not the full-screen root) so Pad Expand
   keeps the design-canvas position. Class sits on the template instance:
   .notice-card is absolute and fills its parent; a sizeless TemplateContainer
   collapses the panel while icon/labels (own pixel size) stay visible. */
.game-form-notice-dialog {
    position: absolute;
    left: 50%;
    bottom: 120px;
    width: 933px;
    height: 1083px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    translate: -50% 0;
    flex-grow: 0;
}

.game-form-notice-dialog--progress {
    height: 957px;
}

/* Full-screen hit target behind sheet chrome; tap dismisses the popup. */
.game-form-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0.001);
    picking-mode: Position;
}

/* Boluo UICanvasTip / TipWindows toast bubble. */
.game-tip-toast {
    position: absolute;
    left: 50%;
    top: 50%;
    min-width: 288px;
    min-height: 138px;
    max-width: 666px;
    padding-left: 60px;
    padding-right: 60px;
    padding-top: 36px;
    padding-bottom: 36px;
    align-items: center;
    justify-content: center;
    background-image: url("../Textures/Shared/tip.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.902);
    -unity-slice-left: 45px;
    -unity-slice-right: 45px;
    -unity-slice-top: 40px;
    -unity-slice-bottom: 40px;
    picking-mode: Ignore;
}

/* Full-screen host for the global tip. Stays put while panel sheets slide. */
.game-tip-toast-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    picking-mode: Ignore;
}

.game-tip-toast__label {
    flex-grow: 0;
    flex-shrink: 1;
    -unity-text-align: middle-center;
    font-size: 36px;
    color: rgba(255, 255, 255, 1);
    white-space: normal;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
}
