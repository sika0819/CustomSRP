.game-music-form__root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Sheet chrome uses shared .game-form-stage; USS authored for 120px above stage
   bottom (Boluo InGameYinYueView yinyuetanchuangkapian anchoredY=120). Per-form gap:
   MusicForm.SheetBottomOffset (GameFormLogic translates stage). */

.game-music-form__music-dialogkapian {
    position: absolute;
    left: 50%;
    margin-left: -517.5px;
    top: 100%;
    margin-top: -1557px;
    margin-right: 0;
    width: 1035px;
    margin-bottom: 0;
    height: 1437px;
    background-image: url("../Textures/MusicForm/music-dialogkapian.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    -unity-slice-left: 140px;
    -unity-slice-right: 140px;
    -unity-slice-top: 140px;
    -unity-slice-bottom: 140px;
    /* chrome layer — let hit-testing fall through to the formBackdrop
       so an empty tap on the dialog card dismisses the popup. */
    picking-mode: Ignore;
}
.game-music-form__hlist {
    position: absolute;
    left: 50%;
    margin-left: -394px;
    top: 84px;
    margin-top: 0;
    margin-right: 0;
    width: 788px;
    margin-bottom: 0;
    height: 101px;
    background-color: rgba(0, 0, 0, 0);
    picking-mode: Ignore;
}
.game-music-form__biao {
    position: absolute;
    left: 50%;
    margin-left: -21px;
    top: 92px;
    margin-top: 0;
    margin-right: 0;
    width: 42px;
    margin-bottom: 0;
    height: 9px;
    background-image: url("../Textures/MusicForm/biao.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}

/* -----------------------------------------------------------------------
   Album strip: horizontal infinite loop (triple-copy strip in C#).
   Width = MeasureTextSize; constant AlbumNameGap between glyph end → next start.
   No ellipsis — long names take their full measured width.
   ----------------------------------------------------------------------- */

.game-music-form__huadong {
    width: 788px;
    height: 101px;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

/* Content host: C# sets left for drag / centering. */
.game-music-form__huadong > VisualElement {
    position: relative;
    height: 101px;
    padding-left: 0;
    picking-mode: Ignore;
}

/* TextElement (not Label) — avoids .unity-label:hover washing text to white.
   Width is assigned in C# from MeasureTextSize; do not lock to a fixed px. */
.game-music-form__album-label {
    position: absolute;
    top: 0;
    flex-grow: 0;
    flex-shrink: 0;
    height: 101px;
    min-height: 101px;
    max-height: 101px;
    margin: 0;
    -unity-text-align: middle-center;
    color: rgba(24, 24, 25, 1.000);
    white-space: nowrap;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
    overflow: visible;
    picking-mode: Position;
    font-size: 48px;
    opacity: 0.3;
}

.game-music-form__album-label--selected {
    font-size: 72px;
    opacity: 1;
    color: rgba(24, 24, 25, 1.000);
}

.game-music-form__album-label--unselected {
    font-size: 48px;
    opacity: 0.3;
    color: rgba(24, 24, 25, 1.000);
}

.game-music-form__mode-button {
    position: absolute;
    right: 82px;
    top: 254px;
    left: auto;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    width: 180px;
    margin-bottom: 0;
    height: 84px;
    /* Transparent hit target; icon is Ignore so clicks land on this button. */
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    picking-mode: Position;
}

/* Inner icon: yy_danqu / yy_list / yy_suiji (set in MusicForm.UpdateModeButton). */
.game-music-form__mode-icon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
/* TextElement (not Label) — same hover-wash fix as album strip labels.
   Match InGameYinYueView title TMP: size 42, characterSpacing 0. */
.game-music-form__title {
    position: absolute;
    left: 86px;
    top: 267px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    width: 400px;
    margin-bottom: 0;
    height: 59px;
    -unity-text-align: middle-left;
    font-size: 42px;
    letter-spacing: 0;
    color: rgba(135, 135, 145, 1.000) !important;
    white-space: nowrap;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
    picking-mode: Ignore;
}

/* Track title mask — clips dual-copy marquee; badge sits after this in flex. */
.game-music-form__track-title-mask {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    picking-mode: Ignore;
}

.game-music-form__track-title-mover {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    picking-mode: Ignore;
}

/* Track row title — Musicitem Text_0: fontSize 45, characterSpacing 4.5
   (TMP 1/100 em → 4.5% of 45px ≈ 2.025px). TextElement avoids hover-wash.
   Width is content-sized; mask clips. Copy B is the marquee duplicate. */
.game-music-form__track-title {
    position: absolute;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-left;
    font-size: 45px;
    letter-spacing: 2px;
    color: rgba(24, 24, 25, 1.000);
    white-space: nowrap;
    overflow: visible;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
    picking-mode: Ignore;
    flex-shrink: 0;
}

/* Theme .unity-label:hover can beat a plain class colour when the sheet
   slides up under the pointer on a pooled reopen. */
.game-music-form__title:hover,
.game-music-form__title:focus,
.game-music-form__title:active {
    color: rgba(135, 135, 145, 1.000) !important;
}
.game-music-form__music-list {
    position: absolute;
    left: 0;
    right: 0;
    top: 381px;
    bottom: 60px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    width: auto;
    height: auto;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    /* Dialog card is picking-mode: Ignore; list must take hits itself. */
    picking-mode: Position;
}
.game-music-form__music-list .unity-list-view__item,
.game-music-form__music-list .unity-collection-view__item {
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    margin: 0;
    border-width: 0;
}
.game-music-form__music-list .unity-scroll-view {
    background-color: rgba(0, 0, 0, 0);
}

/* Boluo V_List Scrollbar Vertical: 20px track (invisible), yy_huadongtiao thumb, right inset ~13. */
.game-music-form__music-list .unity-scroller--vertical {
    width: 20px;
    margin-right: 13px;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.game-music-form__music-list .unity-scroller--vertical .unity-scroller__low-button,
.game-music-form__music-list .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
}
.game-music-form__music-list .unity-scroller--vertical .unity-scroller__slider {
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.game-music-form__music-list .unity-scroller--vertical .unity-base-slider__input,
.game-music-form__music-list .unity-scroller--vertical .unity-base-slider__drag-container,
.game-music-form__music-list .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 0;
    margin: 0;
}
.game-music-form__music-list .unity-scroller--vertical .unity-base-slider__dragger {
    width: 15px;
    min-width: 15px;
    max-width: 15px;
    margin-left: 2.5px;
    margin-right: 2.5px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Textures/MusicForm/yy_huadongtiao.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0px;
    -unity-slice-right: 0px;
    -unity-slice-top: 15px;
    -unity-slice-bottom: 12px;
    border-width: 0;
    border-radius: 0;
}
