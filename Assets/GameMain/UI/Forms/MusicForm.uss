.game-music-form__music-list .unity-list-view__item,
.game-music-form__music-list .unity-collection-view__item {
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    margin: 0;
    border-width: 0;
}
.game-music-form__music-list .unity-scroll-view {
    background-color: rgba(0, 0, 0, 0);
}

/* Boluo V_List Scrollbar Vertical: 20px track (invisible), yy_huadongtiao thumb, right inset ~13. */
.game-music-form__music-list .unity-scroller--vertical {
    width: 20px;
    margin-right: 13px;
    margin-top: 10px;
    margin-bottom: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.game-music-form__music-list .unity-scroller--vertical .unity-scroller__low-button,
.game-music-form__music-list .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
}
.game-music-form__music-list .unity-scroller--vertical .unity-scroller__slider {
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.game-music-form__music-list .unity-scroller--vertical .unity-base-slider__input,
.game-music-form__music-list .unity-scroller--vertical .unity-base-slider__drag-container,
.game-music-form__music-list .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-width: 0;
    border-radius: 0;
    margin: 0;
}
.game-music-form__music-list .unity-scroller--vertical .unity-base-slider__dragger {
    width: 15px;
    min-width: 15px;
    max-width: 15px;
    margin-left: 2.5px;
    margin-right: 2.5px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Textures/MusicForm/yy_huadongtiao.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 0px;
    -unity-slice-right: 0px;
    -unity-slice-top: 15px;
    -unity-slice-bottom: 12px;
    border-width: 0;
    border-radius: 0;
}
