.game-music-form__root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Boluo sheet sits 120px above the bottom; raise stage so the 1437px card is vertically centered. */
.game-music-form__root .game-form-stage {
    margin-top: -1597.5px; /* -1218 (stage half) - 379.5 (sheet nudge) */
}

