<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameFormShared.uss" />
    <Style src="MusicForm.uss" />
    <ui:VisualElement name="root" class="game-music-form__root">
        <ui:VisualElement name="stage" class="game-form-stage">
            <ui:VisualElement name="hintwindows" class="game-music-form__hintwindows">
                <ui:Label name="labeltmp" class="game-music-form__labeltmp" text="播放模式" />
            </ui:VisualElement>
            <ui:VisualElement name="musicDialogkapian" class="game-music-form__music-dialogkapian">
                <ui:VisualElement name="hlist" class="game-music-form__hlist">
                    <ui:VisualElement name="biao" class="game-music-form__biao" />
                    <ui:VisualElement name="huadong" class="game-music-form__huadong" />
                </ui:VisualElement>
                <ui:VisualElement name="modeButton" class="game-music-form__mode-button">
                    <ui:VisualElement name="modeIcon" class="game-music-form__mode-icon" />
                </ui:VisualElement>
                <ui:Label name="title" class="game-music-form__title" text="" />
                <ui:ListView name="musicList" class="game-music-form__music-list" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
