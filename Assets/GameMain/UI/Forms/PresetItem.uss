.game-preset-item__presetitem {
    position: absolute;
    left: 0;
    margin-left: 0;
    top: 0;
    margin-top: 282px;
    margin-right: 0;
    width: 264px;
    margin-bottom: 0;
    height: 55px;
    -unity-text-align: upper-center;
    font-size: 39px;
    color: rgba(25, 25, 26, 1.000);
    white-space: normal;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
