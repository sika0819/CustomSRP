.game-preset-item__root {
    position: relative;
    width: 264px;
    height: 337px;
}

.game-preset-item__cover {
    position: absolute;
    left: 0;
    margin-left: 0;
    top: 0;
    margin-top: 0;
    margin-right: 0;
    width: 264px;
    margin-bottom: 0;
    height: 264px;
    padding: 0;
    border-width: 0;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Textures/PresetItem/zhanweitu1.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
}
.game-preset-item__vip {
    position: absolute;
    left: 100%;
    margin-left: -96px;
    top: 0;
    margin-top: 0;
    margin-right: 0;
    width: 96px;
    margin-bottom: 0;
    height: 51px;
    background-image: url("../Textures/PresetItem/vip.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-preset-item__bofangzhuangtai {
    position: absolute;
    left: 0;
    margin-left: 24px;
    top: 0;
    margin-top: 162px;
    margin-right: 0;
    width: 78px;
    margin-bottom: 0;
    height: 78px;
    background-image: url("../Textures/PresetItem/bofangzhuangtai.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-preset-item__statewaitdownload {
    position: absolute;
    left: 50%;
    margin-left: -30px;
    top: 50%;
    margin-top: -30px;
    margin-right: 0;
    width: 60px;
    margin-bottom: 0;
    height: 60px;
    display: none;
    background-image: url("../Textures/PresetItem/statewaitdownload.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-preset-item__stateerror {
    position: absolute;
    left: 50%;
    margin-left: -30px;
    top: 50%;
    margin-top: -30px;
    margin-right: 0;
    width: 60px;
    margin-bottom: 0;
    height: 60px;
    display: none;
    background-image: url("../Textures/PresetItem/stateerror.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-preset-item__statedownloadsuccess {
    position: absolute;
    left: 50%;
    margin-left: -30px;
    top: 50%;
    margin-top: -30px;
    margin-right: 0;
    width: 60px;
    margin-bottom: 0;
    height: 60px;
    display: none;
    background-image: url("../Textures/PresetItem/statedownloadsuccess.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-preset-item__statedownloading {
    position: absolute;
    left: 50%;
    margin-left: -30px;
    top: 50%;
    margin-top: -30px;
    margin-right: 0;
    width: 60px;
    margin-bottom: 0;
    height: 60px;
    display: none;
    picking-mode: Ignore;
}
.game-preset-item__fill {
    position: absolute;
    left: 0;
    margin-left: 0;
    top: 0;
    margin-top: 0;
    margin-right: 0;
    width: 100%;
    margin-bottom: 0;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}
.game-preset-item__stateready {
    position: absolute;
    left: 50%;
    margin-left: -30px;
    top: 50%;
    margin-top: -30px;
    margin-right: 0;
    width: 60px;
    margin-bottom: 0;
    height: 60px;
    display: none;
    background-image: url("../Textures/PresetItem/stateready.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
/* Boluo state_Playing: 78×78, bars pivot bottom-center at y=-20 from mid. */
.game-preset-item__stateplaying {
    position: absolute;
    left: 0;
    margin-left: 0;
    top: 0;
    margin-top: 0;
    margin-right: 0;
    width: 78px;
    margin-bottom: 0;
    height: 78px;
    display: none;
    picking-mode: Ignore;
}
.game-preset-item__bar-left {
    position: absolute;
    left: 16px;
    top: 39px;
    width: 10px;
    height: 20px;
    margin: 0;
    background-image: url("../Textures/HudIcon/bar-left.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    -unity-slice-left: 0px;
    -unity-slice-right: 0px;
    -unity-slice-top: 4px;
    -unity-slice-bottom: 4px;
    picking-mode: Ignore;
}
.game-preset-item__bar-center {
    position: absolute;
    left: 34px;
    top: 14px;
    width: 10px;
    height: 45px;
    margin: 0;
    background-image: url("../Textures/HudIcon/bar-center.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(166, 255, 0, 1.000);
    -unity-slice-left: 0px;
    -unity-slice-right: 0px;
    -unity-slice-top: 4px;
    -unity-slice-bottom: 4px;
    picking-mode: Ignore;
}
.game-preset-item__bar-right {
    position: absolute;
    left: 52px;
    top: 29px;
    width: 10px;
    height: 30px;
    margin: 0;
    background-image: url("../Textures/HudIcon/bar-right.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    -unity-slice-left: 0px;
    -unity-slice-right: 0px;
    -unity-slice-top: 4px;
    -unity-slice-bottom: 4px;
    picking-mode: Ignore;
}
.game-preset-item__presetitem {
    position: absolute;
    left: 0;
    margin-left: 0;
    top: 0;
    margin-top: 282px;
    margin-right: 0;
    width: 264px;
    margin-bottom: 0;
    height: 55px;
    -unity-text-align: upper-center;
    font-size: 39px;
    color: rgba(25, 25, 26, 1.000);
    white-space: normal;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
}
