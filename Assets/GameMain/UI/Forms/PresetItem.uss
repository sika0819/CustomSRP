    margin-bottom: 0;
    height: 78px;
    background-image: url("../Textures/PresetItem/bofangzhuangtai.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-preset-item__statewaitdownload {
    position: absolute;
    left: 50%;
    margin-left: -30px;
    top: 50%;
    margin-top: -30px;
    margin-right: 0;
    width: 60px;
    margin-bottom: 0;
    height: 60px;
    display: none;
    background-image: url("../Textures/PresetItem/statewaitdownload.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
