.game-preset-item__root {
    position: relative;
    width: 264px;
    height: 337px;
}

.game-preset-item__zhanweitu2-button {
    position: absolute;
    left: 0;
    margin-left: 0;
    top: 0;
    margin-top: 0;
    margin-right: 0;
    width: 264px;
    margin-bottom: 0;
    height: 264px;
    padding: 0;
    border-width: 0;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Textures/PresetItem/zhanweitu2-button.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
}
.game-preset-item__vip {
    position: absolute;
    left: 100%;
    margin-left: -96px;
    top: 0;
    margin-top: 0;
    margin-right: 0;
    width: 96px;
    margin-bottom: 0;
    height: 51px;
    background-image: url("../Textures/PresetItem/vip.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-preset-item__bofangzhuangtai {
    position: absolute;
    left: 0;
    margin-left: 24px;
    top: 0;
    margin-top: 162px;
