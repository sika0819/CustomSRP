.game-storage-full-form__root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

#storageFullCard #primary {
    position: absolute;
    left: 94px;
    top: 789.5px;
    width: 765px;
    height: 156px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}
#storageFullCard #icon {
    position: absolute;
    left: 346.5px;
    top: 122.5px;
    width: 240px;
    height: 240px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    background-image: url("../Textures/StorageFullForm/storage-full-card-icon.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
}
#storageFullCard #title {
    position: absolute;
    left: 296.98px;
    top: 435.02px;
    width: 339.04px;
    height: 76.48px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}
#storageFullCard #body {
    position: absolute;
    left: 94px;
    top: 567.05px;
    width: 765px;
    height: 174.89px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: upper-center;
    font-size: 39px;
    color: rgba(0, 0, 0, 1.000);
    white-space: normal;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
}
#storageFullCard #secondary {
    display: none;
}
.game-storage-full-form__ingamestorage-fullstorageview {
    position: absolute;
    left: 0;
    margin-left: 0;
    top: 0;
    margin-top: 0;
    right: 0;
    margin-right: 0;
    bottom: 0;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0.800);
}
