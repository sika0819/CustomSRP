#request-download-form__card {
    background-image: url("../../Textures/NoticeCard/panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
}

#request-download-form__icon {
    background-image: url("../../Textures/NoticeCard/icon.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
}

/* Override primary label for download action. */
#dialog #primaryLabel {
    font-size: 50px;
}
