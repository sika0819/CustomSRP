    margin-right: 0;
    width: 867px;
    margin-bottom: 0;
    height: 107.65px;
    -unity-text-align: upper-center;
    font-size: 39px;
    color: rgba(0, 0, 0, 1.000);
    white-space: normal;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
}
.game-timer-pause-form__close-button {
    position: absolute;
    left: 50%;
