.game-weather-form__root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Boluo sheet sits 120px above the bottom; raise stage so the 735px card is vertically centered. */
.game-weather-form__root .game-form-stage {
    margin-top: -1948.5px; /* -1218 (stage half) - 730.5 (sheet nudge) */
}

.game-weather-form__weather-dialog {
    position: absolute;
    left: 50%;
    margin-left: -517.5px;
    top: 100%;
    margin-top: -855px;
    margin-right: 0;
    width: 1035px;
    margin-bottom: 0;
    height: 735px;
    background-image: url("../Textures/WeatherForm/weather-dialog.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
}
.game-weather-form__level-background {
    position: absolute;
    left: 50%;
    margin-left: -433.5px;
    top: 100%;
    margin-top: -408px;
    margin-right: 0;
    width: 867px;
    margin-bottom: 0;
    height: 204px;
    background-image: url("../Textures/WeatherForm/level-background.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-weather-form__list {
    position: absolute;
    left: 50%;
    margin-left: -252px;
    top: 100%;
    margin-top: -771px;
    margin-right: 0;
    width: 504px;
    margin-bottom: 0;
    height: 101px;
}
.game-weather-form__huadong {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    width: auto;
    height: auto;
}
.game-weather-form__feng-button,
.game-weather-form__yu-button,
.game-weather-form__wu-button {
    position: absolute;
    top: 8px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    width: 84px;
    height: 84px;
    padding: 0;
    border-width: 0;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.300;
    -unity-text-align: middle-center;
    font-size: 60px;
    color: rgba(24, 24, 25, 1.000);
    white-space: nowrap;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
}
.game-weather-form__feng-button {
    left: 54px;
    margin-left: 0;
}
.game-weather-form__yu-button {
    left: 50%;
    margin-left: -42px;
}
.game-weather-form__wu-button {
    right: 54px;
    left: auto;
    margin-left: 0;
}
.game-weather-form__feng-button .unity-button__text,
.game-weather-form__yu-button .unity-button__text,
.game-weather-form__wu-button .unity-button__text {
    -unity-text-align: middle-center;
    font-size: 60px;
    color: rgba(24, 24, 25, 1.000);
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
    margin: 0;
    padding: 0;
}
.game-weather-form__tab {
    position: absolute;
    left: 50%;
    margin-left: -21px;
    top: 100%;
    margin-top: 4px;
    margin-right: 0;
    width: 42px;
    margin-bottom: 0;
    height: 9px;
    background-image: url("../Textures/WeatherForm/tab.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
#dragHandle #highlight {
    display: flex;
}
#dragHandle #label {
    display: flex;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin: 0;
    translate: 0 0;
    -unity-text-align: middle-center;
}
.game-weather-form__description {
    position: absolute;
    left: 84px;
    right: 84px;
    top: 100%;
    margin-top: -560px;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 0;
    width: auto;
    height: 110px;
    -unity-text-align: upper-center;
    font-size: 39px;
    color: rgba(186, 200, 195, 1.000);
    white-space: normal;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
    overflow: visible;
}
