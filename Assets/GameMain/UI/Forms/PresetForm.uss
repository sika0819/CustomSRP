.game-preset-form__root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.game-preset-form__preset-button {
    position: absolute;
    left: 50%;
    margin-left: -517.5px;
    top: 100%;
    margin-top: -1080px;
    margin-right: 0;
    width: 1035px;
    margin-bottom: 0;
    height: 960px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Textures/PresetForm/preset-button.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    -unity-slice-left: 140px;
    -unity-slice-right: 140px;
    -unity-slice-top: 140px;
    -unity-slice-bottom: 140px;
}

.game-preset-form__title {
    position: absolute;
    left: 84px;
    top: 84px;
    width: 867px;
    height: 101px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: upper-center;
    font-size: 72px;
    color: rgba(25, 25, 26, 1.000);
    white-space: normal;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
}

.game-preset-form__description {
    position: absolute;
    left: 84px;
    top: 234px;
    width: 867px;
    height: 110px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: upper-center;
    font-size: 39px;
    color: rgba(186, 200, 195, 1.000);
    white-space: normal;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
}

.game-preset-form__preset-list {
    position: absolute;
    left: 48px;
    right: 48px;
    top: 380px;
    height: 360px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.game-preset-form__preset-list .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: flex-start;
    padding-left: 12px;
    padding-right: 12px;
    min-height: 100%;
}

.game-preset-form__preset-list .unity-scroll-view__vertical-scroller {
    display: none;
    width: 0;
}

.game-preset-form__scroll-track {
    position: absolute;
    left: 50%;
    margin-left: -120px;
    top: 780px;
    width: 240px;
    height: 18px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    background-image: url("../Textures/PresetForm/scroll-track.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}

.game-preset-form__scroll-track-active {
    position: absolute;
    left: 50%;
    margin-left: -31.5px;
    top: 780px;
    width: 63px;
    height: 18px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    background-image: url("../Textures/PresetForm/scroll-track-active.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
    opacity: 0.500;
}
