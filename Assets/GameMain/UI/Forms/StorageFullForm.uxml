<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameFormShared.uss" />
    <Style src="StorageFullForm.uss" />
    <ui:Template name="NoticeCard" src="../Components/NoticeCard.uxml" />
    <ui:VisualElement name="root" class="game-storage-full-form__root">
        <ui:VisualElement name="ingamestorageFullstorageview" class="game-storage-full-form__ingamestorage-fullstorageview" />
        <ui:VisualElement name="stage" class="game-form-stage">
            <ui:Instance template="NoticeCard" name="storageFullCard" style="position: absolute; left: 50%; margin-left: -466.5px; top: 100%; margin-top: -1173px; margin-right: 0; width: 933px; margin-bottom: 0; height: 1023px;">
                <ui:AttributeOverrides element-name="primaryLabel" text="我知道了" />
                <ui:AttributeOverrides element-name="title" text="温馨提示" />
                <ui:AttributeOverrides element-name="body" text="设备存储空间不足，需至少预留600MB空间才能下载，建议清理存储空间后重试”，无法启动下载。" />
