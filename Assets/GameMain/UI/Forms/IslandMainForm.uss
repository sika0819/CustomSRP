.game-island-main-form__root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.game-island-main-form__hud-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.game-island-main-form__joystick-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.game-island-main-form__joystick-visual {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: visible;
    picking-mode: Ignore;
}
.game-island-main-form__joystick-ring {
    position: absolute;
    width: 444px;
    height: 444px;
    display: flex;
    visibility: hidden;
    opacity: 0;
    overflow: visible;
    background-image: url("../Textures/IslandMainForm/joystick-ring.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-island-main-form__joystick-knob {
    position: absolute;
    width: 180px;
    height: 180px;
    display: flex;
    visibility: hidden;
    opacity: 0;
