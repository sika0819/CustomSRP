.game-playing-badge__root {
    position: relative;
    width: 78px;
    height: 78px;
}

.game-playing-badge__bar-left {
    position: absolute;
    left: 50%;
    margin-left: -23px;
    top: 50%;
    margin-top: 0;
    margin-right: 0;
    width: 10px;
    margin-bottom: 0;
    height: 20px;
    background-image: url("../Textures/PlayingBadge/bar-left.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-playing-badge__bar-right {
    position: absolute;
    left: 50%;
    margin-left: 13px;
    top: 50%;
    margin-top: -10px;
    margin-right: 0;
    width: 10px;
    margin-bottom: 0;
    height: 30px;
    background-image: url("../Textures/PlayingBadge/bar-right.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}
.game-playing-badge__bar-center {
    position: absolute;
    left: 50%;
    margin-left: -5px;
    top: 50%;
    margin-top: -25px;
    margin-right: 0;
    width: 10px;
    margin-bottom: 0;
    height: 45px;
    background-image: url("../Textures/PlayingBadge/bar-center.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(166, 255, 0, 1.000);
    picking-mode: Ignore;
}
