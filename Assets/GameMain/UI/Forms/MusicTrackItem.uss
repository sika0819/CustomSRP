    top: 50%;
    margin-top: 31.01px;
    margin-right: 0;
    margin-bottom: 0;
    display: none;
    -unity-text-align: upper-left;
    font-size: 45px;
    color: rgba(24, 24, 25, 1.000);
    white-space: nowrap;
    translate: -50% -50%;
