.game-music-track-item__root {
    position: relative;
    width: 1035px;
    height: 144px;
}

.game-music-track-item__downloading {
    position: absolute;
    left: 100%;
    margin-left: -144px;
    top: 0;
    margin-top: 40.49px;
    margin-right: 0;
    width: 60px;
    margin-bottom: 0;
    height: 60px;
    display: none;
    background-image: url("../Textures/MusicTrackItem/downloading.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
}
.game-music-track-item__downloaderror {
    position: absolute;
    left: 100%;
    margin-left: -144px;
