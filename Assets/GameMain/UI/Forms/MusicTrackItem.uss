.game-music-track-item__root {
    position: relative;
    width: 100%;
    height: 144px;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
}

.game-music-track-item__music-button {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    width: auto;
    height: auto;
    padding: 0;
    border-width: 0;
    min-width: 0;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
}

.game-music-track-item__panel {
    position: absolute;
    left: 85px;
    top: 0;
    bottom: 0;
    right: 160px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    width: auto;
    height: auto;
    background-color: rgba(0, 0, 0, 0);
    picking-mode: Ignore;
}

.game-music-track-item__label0 {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    right: 0;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: middle-left;
    font-size: 45px;
    color: rgba(24, 24, 25, 1.000);
    white-space: nowrap;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
    overflow: hidden;
    picking-mode: Ignore;
}

.game-music-track-item__label1 {
    display: none;
}

.game-music-track-item__downloadsuccess,
.game-music-track-item__downloadsuccess2 {
    display: none;
}

.game-music-track-item__downloading,
.game-music-track-item__downloaderror,
.game-music-track-item__notdownload,
.game-music-track-item__playinganima {
    position: absolute;
    right: 84px;
    top: 42px;
    left: auto;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    width: 60px;
    height: 60px;
    display: none;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    picking-mode: Ignore;
}

.game-music-track-item__downloading {
    background-image: url("../Textures/MusicTrackItem/downloading.png");
}

.game-music-track-item__downloaderror {
    background-image: url("../Textures/MusicTrackItem/downloaderror.png");
}

.game-music-track-item__notdownload {
    background-image: url("../Textures/MusicTrackItem/notdownload.png");
}

.game-music-track-item__playinganima {
    background-color: rgba(0, 163, 117, 1.000);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
}
