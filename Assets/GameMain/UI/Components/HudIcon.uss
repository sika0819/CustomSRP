.hud-icon {
    overflow: visible;
}

.hud-icon__plate {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 108px;
    height: 108px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    background-image: url("../Textures/HudIcon/plate.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
}

