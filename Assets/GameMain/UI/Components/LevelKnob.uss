.level-knob {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: visible;
}

.level-knob__highlight {
    position: absolute;
    left: -90px;
    top: -90px;
    width: 324px;
    height: 324px;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    background-image: url("../Textures/LevelKnob/highlight.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(255, 255, 255, 1.000);
    display: none;
    picking-mode: Ignore;
}

.level-knob__label {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    -unity-text-align: middle-center;
    font-size: 42px;
    color: rgba(61, 61, 61, 1.000);
    white-space: nowrap;
    -unity-font: url("../Fonts/pingfangsc-medium.ttf");
    overflow: visible;
    display: none;
    picking-mode: Ignore;
}
